# 复制为项目根目录 .env。密钥仅由后端读取，不要放入 NEXT_PUBLIC_*。
TEA_ENV=development
# 已有正式数据实例设为 true；数据卷缺失或数据库未初始化时拒绝启动。
# 首次建立全新实例可保持 false；该选项不替代备份和原件完整性校验。
TEA_REQUIRE_EXISTING_DATA=false
TEA_COOKIE_SECURE=false
TEA_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# 可选：在没有管理员账号的恢复场景中，引导已登录账号成为管理员。
TEA_ADMIN_BOOTSTRAP_TOKEN=
# 可选：用导出的单条六堡茶模板覆盖同编号内置配置；留空加载四条路线。
TEA_TEMPLATE_FILE=

# 留空时运行明确标注的演示助手；不会伪装成已调用大模型。
LLM_BASE_URL=https://aerisun.top/sub2api
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash

# 留空时使用可解释的词项检索；配置后可启用真实向量检索。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# 单次向量批量，1–64；慢速模型可设为 4，每批完成即保存进度。
EMBEDDING_BATCH_SIZE=64
# 本进程真实 HTTP 并发，1–64；首次使用后变更须重启。先以小批次验证服务端额度。
EMBEDDING_HTTP_WORKERS=2
# 单文档请求并行数，1 或 2；超过 32 路 HTTP 需要设为 2。
EMBEDDING_REQUEST_CONCURRENCY=1
# 单次 HTTP 超时，1–60 秒；整次调用仍受总时限约束。
EMBEDDING_HTTP_TIMEOUT_SECONDS=30
# false 时不自动重发已发出但响应不明的请求；正式批量续跑脚本固定使用 false。
EMBEDDING_RETRY_AMBIGUOUS_TIMEOUTS=true
# 可选同账号、同模型、完整输入完全相等的向量复用。
EMBEDDING_INPUT_CACHE=false

# 可选候选重排。未配置时保留关键词/向量融合顺序。
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=

# 必要时才显式开启图片识别；通常使用本地文本和既有识别缓存。
# 不完整或识别不确定的正文保留原件，不进入检索。
VISION_OCR_ENABLED=false
# OCR 页面处理并发，1–128；视觉模型调用另受下方并发上限控制，首次使用后需重启才能改。
VISION_OCR_WORKERS=128
# DeepSeek 图片识别调用并发，同一数据根跨进程共享，1–64；按服务端额度设置。
VISION_OCR_REQUEST_WORKERS=32
# 可选按完整 HTTP 响应健康度升降页面处理并发；页面和模型调用上限分别由上面两项固定。
# 开启时页面处理从 min(WORKERS,16) 起步；429/5xx/连接或读取超时降额且至少冷却30秒。
VISION_OCR_ADAPTIVE=false

# 可选：对已通过归属、国家与有效期过滤的候选调用 /rerank。
# 留空时保留原检索顺序；失败时回退并返回明确提示。
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=

# 高质量布局解析可选安装 Docling；基础解析不需要下载模型。
TEA_PARSER=basic

# 单机持久采集队列：全局下载、真实同域连接、解析/向量处理。
# internal（默认）：主站处理全部账号；external：系统共享法规交给独立受审计 worker。
# external 仍处理私有上传/采集，查询共享法规仍遵循原审核与权限规则。
TEA_SHARED_LIBRARY_WORKERS=internal
TEA_COLLECT_WORKERS=8
TEA_COLLECT_PER_HOST=2
TEA_PROCESS_WORKERS=2
# 向量文档任务并发，1–32，实际不超过 TEA_PROCESS_WORKERS。
TEA_EMBED_WORKERS=2
