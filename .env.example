# 复制为项目根目录 .env。密钥仅由后端读取，不要放入 NEXT_PUBLIC_*。
TEA_ENV=development
TEA_COOKIE_SECURE=false
TEA_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
TEA_TEMPLATE_FILE=config/workflows/china-indonesia.json

# 留空时运行明确标注的演示助手；不会伪装成已调用大模型。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 留空时使用可解释的词项检索；配置后可启用真实向量检索。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# 高质量布局解析可选安装 Docling；基础解析不需要下载模型。
TEA_PARSER=basic
