# 新实例：复制为 data/config/application.env（目录权限 700、文件权限 600）。
# 已有实例：停服后运行 make instance-adopt，保留原密钥与数据库。
# TEA_DATA_DIR / TEA_CONFIG_DIR / TEA_ENV_FILE 在启动环境设置，不能写在本文件。
# 密钥仅由后端读取，不要放入 NEXT_PUBLIC_*。路径说明见 docs/INSTANCE_MANAGEMENT.md。
TEA_ENV=development
# 已有正式数据实例设为 true；数据卷缺失或数据库未初始化时拒绝启动。
# 首次建立全新实例可保持 false；该选项不替代备份和原件完整性校验。
TEA_REQUIRE_EXISTING_DATA=false
TEA_COOKIE_SECURE=false
TEA_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# 可选：在没有管理员账号的恢复场景中，引导已登录账号成为管理员。
TEA_ADMIN_BOOTSTRAP_TOKEN=
# 可选：用导出的单条六堡茶模板覆盖同编号内置配置；留空加载四条路线。
TEA_TEMPLATE_FILE=

# 留空时运行明确标注的演示助手；不会伪装成已调用大模型。
LLM_BASE_URL=https://aerisun.top/sub2api
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash

# 对话调度与法律分析使用的 Agent 模型；不改变文档处理使用的 LLM_MODEL。
AGENT_MODEL=Nemotron-3.5
AGENT_REASONING_EFFORT=high
# 留空继承 LLM_BASE_URL / LLM_API_KEY；密钥仅在后端使用。
AGENT_BASE_URL=
AGENT_API_KEY=
# 独立联网搜索 / 识图工具网关；留空继承 Agent 地址。必须为 HTTPS。
AGENT_TOOLS_BASE_URL=https://aerisun.top/sub2api

# Embedding 继续使用原有云端接口和密钥，由 RAGFlow 发起模型调用。
# make ragflow-bootstrap 将它们配置到本机 RAGFlow；以下密钥均不进入前端。
EMBEDDING_BASE_URL=https://aerisun.top/sub2api
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3-embedding-4b

# 可选远端重排，三项同时配置；make ragflow-bootstrap 注册到 RAGFlow。
# 使用兼容 /rerank 的接口；Base URL 填该接口的上级路径。
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=

# MinerU 云端精准解析 API（v4），本机不安装 MinerU/OCR/视觉模型。
MINERU_API_TOKEN=
# 固定使用精准 VLM，保留表格、公式、图片、版面和物理页码。
MINERU_LANGUAGE=en
# 提交和查询使用独立的跨进程限流，并留约 5% 余量。
# PDF 超过 200 页自动机械分段；单批上传不超过 50 文件。
MINERU_SUBMIT_INTERVAL_SECONDS=0.21
MINERU_RESULT_INTERVAL_SECONDS=0.062
# 128 是已验证稳定档；自动探测继续向上找边界。
MINERU_MAX_ACTIVE_TASKS=128
# 真实队列跑满并完成足量任务后升档；429/队列已满立即退档，连续超时也退档。
# 自动档约按当前档 1.5 倍提高；从已验证 128 档继续探索至 256。
# 上限是保护阈值，达到它或队列不足都不代表测到了服务的物理上限。
MINERU_AUTO_CONCURRENCY=true
MINERU_CONCURRENCY_CEILING=256
MINERU_CONCURRENCY_WINDOW_SECONDS=180
MINERU_POLL_SECONDS=16

# 图片识别单次模型响应等待上限，10–600 秒；复杂表格默认给 180 秒。
VISION_OCR_REQUEST_TIMEOUT_SECONDS=180

# make ragflow-up 启动本机服务；make ragflow-bootstrap 自动填写以下三项。
# 不配置时明确显示检索未就绪，不生成假向量或回退到旧本地检索。
RAGFLOW_BASE_URL=http://127.0.0.1:19380
RAGFLOW_API_KEY=
# RAGFlow 注册后的模型实例 ID，bootstrap 自动读取，不是用户提供的 API 密钥。
RAGFLOW_EMBEDDING_MODEL=
# 单份文档一次最多并行写入 8 个结构化块，每个块成功后保存进度。
RAGFLOW_CHUNK_CONCURRENCY=8
# 可选：在 RAGFlow 内配置的重排模型实例 ID。
RAGFLOW_RERANK_MODEL=
RAGFLOW_API_PORT=19380
RAGFLOW_WEB_PORT=18080

# 单机持久采集队列：全局下载、真实同域连接、解析/向量处理。
# internal（默认）：主站处理全部账号；external：系统共享法规交给独立受审计 worker。
# external 仍处理私有上传/采集，查询共享法规仍遵循原审核与权限规则。
TEA_SHARED_LIBRARY_WORKERS=internal
TEA_COLLECT_WORKERS=8
TEA_COLLECT_PER_HOST=2
TEA_PROCESS_WORKERS=2
# MinerU / 文档解析领取上限为 128；此项与逐页 OCR 容量分别限制。
TEA_PARSE_WORKERS=2
# OCR 页面本地处理并发上限；固定运行 128 个页面槽，仍遵守服务端 Retry-After。
VISION_OCR_WORKERS=128
VISION_OCR_ADAPTIVE=false
# 视觉模型实际请求并发；独立于页面渲染和处理槽位，固定为 32。
VISION_OCR_REQUEST_WORKERS=32
# 向量文档任务并发，1–32，实际不超过 TEA_PROCESS_WORKERS。
TEA_EMBED_WORKERS=2
