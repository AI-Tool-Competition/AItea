FROM python:3.12-slim-trixie
RUN pip install --no-cache-dir uv==0.10.10
WORKDIR /app
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev
COPY backend/app ./app
COPY config ./config
ENV TEA_TEMPLATE_FILE=/app/config/workflows/china-indonesia.json
RUN groupadd --gid 10001 tea && useradd --uid 10001 --gid tea --no-create-home tea && mkdir /data && chown tea:tea /data
ENV PATH="/app/.venv/bin:$PATH" TEA_DATA_DIR=/data PYTHONUNBUFFERED=1
USER tea
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/tea/health', timeout=4)"
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
