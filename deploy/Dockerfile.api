FROM python:3.12-slim-trixie AS dependencies
COPY --from=ghcr.io/astral-sh/uv:0.10.10 /uv /usr/local/bin/uv
WORKDIR /app/backend
COPY backend/pyproject.toml backend/uv.lock ./
ENV UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1
RUN uv sync --locked --no-dev --no-install-project

FROM python:3.12-slim-trixie AS runtime
ARG TEA_REVISION=unknown
LABEL org.opencontainers.image.source="https://github.com/AI-Tool-Competition/AItea" \
      org.opencontainers.image.revision=$TEA_REVISION
WORKDIR /app/backend
COPY --from=dependencies /app/backend/.venv ./.venv
COPY backend/app ./app
COPY config /app/config
COPY scripts/run_workers.py scripts/production.py /app/scripts/
RUN groupadd --gid 10001 tea && useradd --uid 10001 --gid tea --no-create-home tea
ENV PATH="/app/backend/.venv/bin:$PATH" PYTHONPATH=/app/backend \
    TEA_DATA_DIR=/data PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
USER tea
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s CMD python -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:'+os.getenv('TEA_API_PORT','8000')+'/api/tea/health', timeout=4)"
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
