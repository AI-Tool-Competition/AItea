FROM node:22.23.0-bookworm-slim AS build
WORKDIR /app
RUN npm install --global pnpm@10.26.2
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY frontend/ ./
ARG TEA_API_URL=http://api:8000
ARG TEA_BASE_PATH=/aitea
ENV TEA_API_URL=$TEA_API_URL NEXT_PUBLIC_TEA_BASE_PATH=$TEA_BASE_PATH SKIP_ENV_VALIDATION=1 NEXT_TELEMETRY_DISABLED=1 NEXT_CONFIG_BUILD_OUTPUT=standalone
RUN pnpm build

FROM node:22.23.0-bookworm-slim AS runtime-base
ARG TEA_REVISION=unknown
ARG TEA_BASE_PATH=/aitea
LABEL org.opencontainers.image.source="https://github.com/AI-Tool-Competition/AItea" \
      org.opencontainers.image.revision=$TEA_REVISION
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000 TEA_BASE_PATH=$TEA_BASE_PATH
USER node
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s CMD node -e "fetch('http://127.0.0.1:'+process.env.PORT+process.env.TEA_BASE_PATH).then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "server.js"]

# The prebuilt context is validated by scripts/production.py.
FROM runtime-base AS prebuilt
COPY --chown=node:node . ./

FROM runtime-base AS runtime
COPY --from=build --chown=node:node /app/.next/standalone ./
COPY --from=build --chown=node:node /app/.next/static ./.next/static
COPY --from=build --chown=node:node /app/public ./public
