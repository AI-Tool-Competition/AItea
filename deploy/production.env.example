# Non-secret deployment settings. Generate real settings with make production-prepare.
# The Docker daemon must see this exact existing directory; no empty volume fallback.
TEA_INSTANCE_DATA=/srv/aitea/data
TEA_INSTANCE_CONFIG=/srv/aitea/config
TEA_PUBLIC_ORIGIN=https://example.com
TEA_BASE_PATH=/aitea
TEA_UID=10001
TEA_GID=10001
TEA_API_PORT=8000
TEA_WEB_PORT=3000
TEA_GATEWAY_PORT=3080
TEA_COOKIE_SECURE=true
TEA_IMAGE_TAG=local
TEA_REVISION=unknown
TEA_COMPOSE_PROJECT=aitea-production
